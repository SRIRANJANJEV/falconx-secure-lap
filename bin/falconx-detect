#!/bin/bash
# FALCON-X Detection CLI
# Control interface for the detection engine

FALCONX_DIR="/opt/falconx"
PYTHON_CMD="${PYTHON_CMD:-python3}"
ENGINE_SCRIPT="${FALCONX_DIR}/falconx/main.py"
PID_FILE="/var/run/falconx-engine.pid"
LOG_FILE="/var/log/falconx-engine.log"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

print_status() {
    local status=$1
    local message=$2
    case $status in
        "ok")
            echo -e "${GREEN}[OK]${NC} $message"
            ;;
        "error")
            echo -e "${RED}[ERROR]${NC} $message"
            ;;
        "warn")
            echo -e "${YELLOW}[WARN]${NC} $message"
            ;;
        *)
            echo "[INFO] $message"
            ;;
    esac
}

check_root() {
    if [ "$EUID" -ne 0 ]; then
        print_status "error" "This command requires root privileges"
        exit 1
    fi
}

is_running() {
    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE")
        if ps -p "$pid" > /dev/null 2>&1; then
            return 0
        else
            rm -f "$PID_FILE"
            return 1
        fi
    fi
    return 1
}

start_engine() {
    if is_running; then
        print_status "warn" "Engine is already running (PID: $(cat $PID_FILE))"
        return 1
    fi

    print_status "info" "Starting FALCON-X detection engine..."

    # Create log directory if needed
    mkdir -p "$(dirname "$LOG_FILE")"

    # Start engine in background
    $PYTHON_CMD "$ENGINE_SCRIPT" --interface "$INTERFACE" >> "$LOG_FILE" 2>&1 &
    pid=$!
    echo $pid > "$PID_FILE"

    sleep 2

    if is_running; then
        print_status "ok" "Engine started successfully (PID: $pid)"
        return 0
    else
        print_status "error" "Failed to start engine"
        return 1
    fi
}

stop_engine() {
    if ! is_running; then
        print_status "warn" "Engine is not running"
        return 1
    fi

    pid=$(cat "$PID_FILE")
    print_status "info" "Stopping engine (PID: $pid)..."

    kill "$pid"
    sleep 2

    if is_running; then
        print_status "warn" "Engine did not stop gracefully, forcing..."
        kill -9 "$pid"
        sleep 1
    fi

    rm -f "$PID_FILE"
    print_status "ok" "Engine stopped"
    return 0
}

show_status() {
    if is_running; then
        pid=$(cat "$PID_FILE")
        print_status "ok" "Engine is running (PID: $pid)"
        echo "Interface: ${INTERFACE:-eth0}"
        echo "Log file: $LOG_FILE"
    else
        print_status "error" "Engine is not running"
    fi
}

run_test() {
    print_status "info" "Running detection test..."
    TEST_SCRIPT="${FALCONX_DIR}/tests/lab/generate_traffic.py"

    if [ ! -f "$TEST_SCRIPT" ]; then
        print_status "error" "Test script not found: $TEST_SCRIPT"
        return 1
    fi

    $PYTHON_CMD "$TEST_SCRIPT" --target 127.0.0.1 --mode normal
    print_status "ok" "Test completed"
}

show_incidents() {
    print_status "info" "Recent incidents:"
    # This would query the engine for incidents
    # For now, show a placeholder
    echo "Incident query requires engine integration"
}

show_interface() {
    print_status "info" "Network interfaces:"
    ip link show 2>/dev/null || ifconfig 2>/dev/null
}

run_demo() {
    print_status "info" "FALCON-X Safe Demonstration"
    echo ""
    echo "This demonstration generates controlled local traffic to test detection capabilities."
    echo "All traffic is directed to localhost (127.0.0.1) for safe testing."
    echo ""

    local MODE="${2:-normal}"
    local TARGET="${3:-127.0.0.1}"
    local COUNT="${4:-10}"

    print_status "info" "Mode: $MODE"
    print_status "info" "Target: $TARGET"
    print_status "info" "Count: $COUNT"
    echo ""

    # Check if engine is running
    if ! is_running; then
        print_status "warn" "Engine is not running. Start engine first with: $0 start"
        print_status "info" "Starting engine temporarily for demo..."
        INTERFACE=""  # Auto-detect
        start_engine
        sleep 3
    fi

    TEST_SCRIPT="${FALCONX_DIR}/tests/lab/generate_traffic.py"

    if [ ! -f "$TEST_SCRIPT" ]; then
        print_status "error" "Test script not found: $TEST_SCRIPT"
        return 1
    fi

    print_status "info" "Generating demonstration traffic..."
    $PYTHON_CMD "$TEST_SCRIPT" --target "$TARGET" --mode "$MODE" --count "$COUNT"

    echo ""
    print_status "info" "Waiting for detection processing..."
    sleep 5

    print_status "info" "Demo completed. Check incidents with: $0 incidents"
    print_status "info" "Check dashboard at: http://localhost:8080"
}

# Main command handling
case "$1" in
    start)
        check_root
        INTERFACE="${2:-}"  # Empty string for auto-detection
        start_engine
        ;;
    stop)
        check_root
        stop_engine
        ;;
    status)
        show_status
        ;;
    test)
        run_test
        ;;
    demo)
        run_demo "$@"
        ;;
    incidents)
        show_incidents
        ;;
    interface)
        show_interface
        ;;
    *)
        echo "FALCON-X Detection CLI"
        echo ""
        echo "Usage: $0 {start|stop|status|test|demo|incidents|interface} [options]"
        echo ""
        echo "Commands:"
        echo "  start [interface]   Start detection engine (default: auto-detect)"
        echo "  stop                Stop detection engine"
        echo "  status              Show engine status"
        echo "  test                Run safe detection test"
        echo "  demo [mode] [target] [count]  Run safe demonstration"
        echo "                      Modes: normal, icmp-burst, dns-burst, syn-burst, port-scan-simulation"
        echo "                      Target: default 127.0.0.1 (localhost only)"
        echo "                      Count: default 10"
        echo "  incidents           Show recent incidents"
        echo "  interface           Show network interfaces"
        echo ""
        echo "Examples:"
        echo "  $0 start                    Start with auto-detected interface"
        echo "  $0 start eth0              Start on eth0"
        echo "  $0 demo normal             Run normal traffic demo"
        echo "  $0 demo syn-burst          Run SYN burst demo"
        echo "  $0 demo port-scan-simulation  Run port scan demo"
        echo ""
        exit 1
        ;;
esac

exit $?
